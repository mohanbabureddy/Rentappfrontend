# i18next lists an optional typescript peer (^5||^6||^7) newer than the typescript react-scripts@5.0.1
# pins (^3||^4). It is peerOptional, so this is a safe resolution -- and it is how the committed
# lockfile was generated. Without it a plain `npm install` fails with ERESOLVE (this bit the
# Docker build, and Render runs its own plain install before any build command).
legacy-peer-deps=true
